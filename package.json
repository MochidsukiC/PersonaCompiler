{
  "name": "persona-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Persona Compiler desktop simulation observatory",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run && vitest run --config vitest.backend.config.ts",
    "test:connection": "vitest run --config vitest.connection.config.ts",
    "test:persistence": "vitest run --config vitest.persistence.config.ts",
    "rebuild:native": "electron-rebuild -w node-pty",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.6",
    "chokidar": "5.0.0",
    "lucide-react": "1.45.0",
    "node-pty": "1.2.0-beta.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "ws": "8.21.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
